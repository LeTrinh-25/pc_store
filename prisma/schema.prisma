generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Int
  brand       String      @default("")
  oldPrice    Int?
  warranty    String      @default("Đang cập nhật")
  origin      String      @default("Đang cập nhật")
  image       String
  images      String[]    @default([])
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  specs       Json        @default("{}")
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  reviews     Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  content   String
  createdAt DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  category  String   @default("Tin tức")
  excerpt   String   @default("")
  image     String   @default("")
  content   String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Int
  status    OrderStatus @default(PENDING)
  name      String
  phone     String
  address   String
  payment   String
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}
